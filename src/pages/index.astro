---
import BaseLayout from "../layouts/BaseLayout.astro";

const phoneHref = "tel:+447477649906";
const phoneLabel = "07477 649906";
const waHref =
  "https://wa.me/447477649906?text=Hi%20Birmingham%20Jump%20Start%2C%20I%20need%20a%20jump%20start.";

const arrow =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>';

const faqs = [
  {
    q: "How much does a jump start cost in Birmingham?",
    a: "We give you a fixed, honest quote on the phone before we set off, so you always know the price upfront. No hidden fees, no night-time surprises, no membership required. Just call 07477 649906 and ask.",
  },
  {
    q: "How quickly can you reach me?",
    a: "Our technicians are based across Birmingham, so most callouts are reached within 30 to 60 minutes depending on traffic and your exact location. When you call, we will give you a realistic ETA, and keep you updated if anything changes.",
  },
  {
    q: "Do I need AA or RAC membership?",
    a: "No. And that is the point. Unlike the big breakdown clubs, there is no yearly fee and no membership to join. You simply pay for the job when you need help. One call, one fixed quote, problem solved.",
  },
  {
    q: "Which areas do you cover?",
    a: "All of Birmingham plus the wider West Midlands, including Walsall, Coventry, Solihull, Tamworth, Water Orton, Coleshill and Sutton Coldfield. If you are nearby and unsure, call us. We will tell you straight away whether we can reach you.",
  },
  {
    q: "My car is in an underground or multi-storey car park. Can you still help?",
    a: "Yes. Our technicians carry portable jump-start equipment that works anywhere: underground car parks, tight driveways, narrow streets. Just tell us where you are and we will come to you.",
  },
  {
    q: "Can you jump start hybrid or electric cars?",
    a: "Yes. We can help with 12-volt auxiliary battery problems on hybrids and electric cars, and we recover EVs that will not move. If you are unsure what is wrong, describe the symptoms on the phone and we will advise honestly.",
  },
  {
    q: "Do you just start the car, or check what is actually wrong?",
    a: "Every jump start includes a free battery health check. We will tell you whether your battery is healthy, on its way out, or the real problem is something else, so you are not stranded again next week. If you need a new battery, we can often supply and fit one on the spot.",
  },
  {
    q: "What happens if the jump start does not work?",
    a: "Then we will tell you honestly what is going on. No jargon, no pressure. If it is the battery, we can usually replace it there and then. If it is something bigger, we will recover your vehicle to your home or a garage of your choice.",
  },
];

const services = [
  {
    img: "/images/car-battery-replacement-birmingham.webp?v=2",
    alt: "Technician fitting a new car battery under an open bonnet in Birmingham",
    t: "Battery Replacement",
    d: "Battery finished? We supply and fit a new one on the spot, so one visit solves the whole problem.",
  },
  {
    img: "/images/tow-truck-loading-car-birmingham.webp",
    alt: "Birmingham Jump Start tow truck loading an SUV at dusk",
    t: "Towing and Recovery",
    d: "Car not starting at all? We tow it safely to your home, your garage, or wherever it needs to go.",
  },
  {
    img: "/images/emergency-fuel-delivery-birmingham.webp?v=2",
    alt: "Technician delivering emergency fuel to a stranded car in Birmingham",
    t: "Emergency Fuel Delivery",
    d: "Run out of fuel? We bring petrol or diesel to you. Faster and safer than walking to a station.",
  },
  {
    img: "/images/car-lockout-service-birmingham.webp?v=2",
    alt: "Technician unlocking a car door with professional tools in Birmingham",
    t: "Car Lockout",
    d: "Locked your keys inside? We open the car without damage and get you back behind the wheel.",
  },
  {
    img: "/images/mobile-tyre-change-birmingham.webp?v=2",
    alt: "Mobile tyre change at the roadside in Birmingham",
    t: "Tyre Change",
    d: "Flat tyre at the roadside? We fit your spare where you are, so you can drive on safely.",
  },
  {
    img: "/images/car-breakdown-recovery-birmingham.webp",
    alt: "Car secured on a Birmingham Jump Start flatbed recovery truck",
    t: "Breakdown Recovery",
    d: "Broken down anywhere in the West Midlands? We recover you and the vehicle, day or night.",
  },
];

const areas = [
  "Birmingham",
  "Walsall",
  "Coventry",
  "Solihull",
  "Tamworth",
  "Water Orton",
  "Coleshill",
  "Sutton Coldfield",
  "City Centre",
  "Edgbaston",
  "Moseley",
  "Kings Heath",
  "Erdington",
  "Aston",
  "Digbeth",
  "Harborne",
  "Selly Oak",
  "Perry Barr",
];
---

<BaseLayout
  title="24/7 Jump Start Birmingham | Car Battery Jump Start Service"
  description="Stranded with a flat battery in Birmingham? Birmingham Jump Start reaches you 24/7: fast local jump starts, fixed quote upfront, no membership needed. Call 07477 649906."
  faq={faqs}
>
  <!-- ============ HERO ============ -->
  <section class="hero" id="top">
    <div class="wrap">
      <span class="eyebrow rv"><span class="dot"></span>24/7 jump start and recovery, Birmingham</span>
      <h1 class="rv rv-d1">
        Dead battery? <span class="hl">Back on the road</span> in minutes.
      </h1>
      <p class="sub rv rv-d2">
        A local technician comes to you anywhere in Birmingham, day or night,
        usually within 30 to 40 minutes of your call. Fixed quote on the phone
        before we set off. No membership needed.
      </p>
      <div class="hero-ctas rv rv-d2">
        <a href={phoneHref} class="btn btn-yellow">
          Call {phoneLabel}
          <span class="arr-c" set:html={arrow} />
        </a>
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-white">
          WhatsApp us
          <span class="arr-c" set:html={arrow} />
        </a>
      </div>
      <p class="hero-eta rv rv-d2">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z" /></svg>
        At your car within 30 to 40 minutes of your call
      </p>
    </div>
    <div class="hero-photo rv">
      <div class="ph">
        <img
          src="/images/birmingham-jump-start-hero.webp?v=2"
          alt="Birmingham Jump Start technician jump starting a car at dusk with the branded recovery van and Birmingham skyline behind"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1600"
          height="1066"
        />
      </div>
      <div class="hero-floats">
        <div class="float-card fc-1">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M13 2 4.5 13.5H11L9.5 22 19 10h-6.5L13 2z" /></svg>
          </span>
          <div>
            <strong>Jump Start</strong>
            <span>Flat battery running again in minutes</span>
          </div>
        </div>
        <div class="float-card fc-2">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z" /></svg>
          </span>
          <div>
            <strong>24/7, every day</strong>
            <span>Nights, weekends and bank holidays</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BLACK BAND ============ -->
  <section class="band-black" aria-label="All services">
    <div class="wrap">
      <div class="sec-head center rv">
        <span class="eyebrow on-dark"><span class="dot"></span>All services</span>
        <h2>One call covers every roadside problem.</h2>
        <p class="lede">
          Jump starts, recovery and towing across Birmingham and the West
          Midlands, 24 hours a day.
        </p>
      </div>
      <ul class="chips rv">
        {["Jump Start", "Battery Replacement", "Towing and Recovery", "Emergency Fuel Delivery", "Car Lockout", "Tyre Change", "Breakdown Recovery"].map((c) => (
          <li><i aria-hidden="true"></i>{c}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="sec" id="services">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>Services</span>
        <h2>Choose the service you need.</h2>
        <p class="lead">
          Every job starts with a fixed quote on the phone. Agreed before we
          set off and honoured when we arrive.
        </p>
      </div>

      <article class="svc-hero-card rv">
        <div class="svc-photo">
          <img
            src="/images/car-jump-start-birmingham.webp?v=2"
            alt="Birmingham Jump Start technician jump starting a car beside the branded recovery van"
            loading="lazy"
            decoding="async"
            width="1200"
            height="800"
          />
        </div>
        <div class="svc-info">
          <div class="txt">
            <span class="kicker">Our signature service</span>
            <h3>Jump Start</h3>
            <p>
              Flat battery? We come to you and get the car running, usually in
              minutes. Every jump start includes a free battery health check, so
              you know whether the battery will let you down again.
            </p>
          </div>
          <a class="svc-go" href={phoneHref} aria-label="Call for a jump start">
            <span set:html={arrow} style="display:inline-flex" />
          </a>
        </div>
      </article>

      <div class="svc-grid">
        {services.map((s, i) => (
          <article class={`svc-card rv ${i % 2 === 1 ? "rv-d1" : ""}`}>
            <div class="svc-photo">
              <img src={s.img} alt={s.alt} loading="lazy" decoding="async" width="1200" height="800" />
            </div>
            <div class="svc-info">
              <div class="txt">
                <span class="kicker">birminghamjumpstart.co.uk</span>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </div>
              <a class="svc-go" href={phoneHref} aria-label={`Call about ${s.t}`}>
                <span set:html={arrow} style="display:inline-flex" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ YELLOW BAND ============ -->
  <section class="band-yellow" aria-label="About the service">
    <div class="in">
      <div class="wrap">
        <span class="eyebrow on-yellow rv"><span class="dot"></span>The service</span>
        <h2 class="rv rv-d1">One team, every roadside fix.</h2>
        <p class="lede rv rv-d1">
          Birmingham Jump Start is a local recovery team, not a national call
          centre. Three things stay the same on every job.
        </p>
        <div class="circles">
          <div class="circle rv">
            <span class="circle-ic" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M13 2 4.5 13.5H11L9.5 22 19 10h-6.5L13 2z" /></svg>
            </span>
            <strong>Fast response</strong>
            <span>Technicians based across Birmingham and the West Midlands.</span>
          </div>
          <div class="circle rv rv-d1">
            <span class="circle-ic" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 2H2v10l9.3 9.3a1 1 0 0 0 1.4 0l8.6-8.6a1 1 0 0 0 0-1.4L12 2zm3 7.5A1.5 1.5 0 1 1 16.5 8 1.5 1.5 0 0 1 15 9.5z" /></svg>
            </span>
            <strong>Upfront pricing</strong>
            <span>A fixed quote on the phone before we set off. No hidden fees.</span>
          </div>
          <div class="circle rv rv-d2">
            <span class="circle-ic" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 2 4 6v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6l-8-4zm-1.2 13.6-3.2-3.2 1.4-1.4 1.8 1.8 4.2-4.2 1.4 1.4-5.6 5.6z" /></svg>
            </span>
            <strong>Fully insured</strong>
            <span>Every visit covered, every vehicle handled with care.</span>
          </div>
        </div>
        <div class="duo">
          <div class="duo-card duo-white rv">
            <span class="ic">
              <svg viewBox="0 0 24 24"><path d="M13 2 4.5 13.5H11L9.5 22 19 10h-6.5L13 2z" /></svg>
            </span>
            <div>
              <h3>What Birmingham Jump Start does</h3>
              <p>
                Jump starts, battery replacement, towing, fuel delivery, car
                lockouts, tyre changes and full breakdown recovery across
                Birmingham and the West Midlands, 24 hours a day, 7 days a week.
              </p>
            </div>
          </div>
          <div class="duo-card duo-black rv rv-d1">
            <span class="ic">
              <svg viewBox="0 0 24 24"><path d="M12 2 4 6v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6l-8-4zm-1.2 13.6-3.2-3.2 1.4-1.4 1.8 1.8 4.2-4.2 1.4 1.4-5.6 5.6z" /></svg>
            </span>
            <div>
              <h3>What every visit includes</h3>
              <p>
                A fixed quote before we set off. A free battery health check
                with every jump start. No membership, no yearly fee, no surprise
                charges.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHY US ============ -->
  <section class="sec" id="why">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>Why drivers call us</span>
        <h2>Built for the worst moment of your day.</h2>
        <p class="lead">
          A flat battery never happens at a good time. This service exists for
          the 7am school run and the midnight car park alike.
        </p>
      </div>
      <div class="why-grid">
        <article class="why-card w-white rv">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-5 0-9 2.5-9 6v2h18v-2c0-3.5-4-6-9-6z" /></svg>
          </span>
          <h3>No membership.</h3>
          <p>
            The big breakdown clubs charge you every year, whether you break
            down or not. With us there is no membership. You call, we come, you
            pay for the job.
          </p>
        </article>
        <article class="why-card w-yellow rv rv-d1">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2H2v10l9.3 9.3a1 1 0 0 0 1.4 0l8.6-8.6a1 1 0 0 0 0-1.4L12 2zm3 7.5A1.5 1.5 0 1 1 16.5 8 1.5 1.5 0 0 1 15 9.5z" /></svg>
          </span>
          <h3>Fixed quote first.</h3>
          <p>
            You know the price before we move. It is agreed on the phone and
            honoured on arrival. It does not go up because it is 2am.
          </p>
        </article>
        <article class="why-card w-black rv">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5z" /></svg>
          </span>
          <h3>Local technicians.</h3>
          <p>
            We are based in Birmingham. Our technicians know the car parks, the
            junctions and the back streets, and they give you an honest arrival
            time.
          </p>
        </article>
        <article class="why-card w-white rv rv-d1">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M16 7V5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-2h3a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1h-3zm-5 9-3-4h2V8l3 4h-2v4z" /></svg>
          </span>
          <h3>We find the cause.</h3>
          <p>
            Anyone can clip on jump leads. We also check your battery health for
            free, so you do not pay for the same rescue twice in one month.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="sec" id="how">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>How it works</span>
        <h2>From your call to moving again.</h2>
        <p class="lead">
          Every job follows the same four steps, so you always know what
          happens next.
        </p>
      </div>
      <div class="steps">
        <article class="step rv">
          <span class="num">01</span>
          <h3>You call.</h3>
          <p>
            One number, answered 24/7 by a real person. Tell us where you are
            and what happened.
          </p>
        </article>
        <article class="step rv rv-d1">
          <span class="num">02</span>
          <h3>We come to you.</h3>
          <p>
            The nearest technician heads straight to you, usually within 30 to
            40 minutes, and we give you an honest arrival time on the phone.
          </p>
        </article>
        <article class="step rv rv-d2">
          <span class="num">03</span>
          <h3>Fixed on the spot.</h3>
          <p>
            Most problems are fixed where you are: jump start, new battery,
            fuel, tyre change or lockout.
          </p>
        </article>
        <article class="step rv">
          <span class="num">04</span>
          <h3>You drive away.</h3>
          <p>
            We run a free battery health check before we leave, so you know it
            will start tomorrow too.
          </p>
        </article>
      </div>
      <div class="steps-cta rv">
        <a href={phoneHref} class="btn btn-yellow">
          Call {phoneLabel}
          <span class="arr-c" set:html={arrow} />
        </a>
      </div>
    </div>
  </section>

  <!-- ============ AREAS ============ -->
  <section class="sec" id="areas">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>Coverage</span>
        <h2>Wherever you are in Birmingham, we are close.</h2>
        <p class="lead">
          Technicians are stationed across the city and the wider West
          Midlands. Most callouts are reached in 30 to 60 minutes.
        </p>
      </div>
      <ul class="areas rv">
        {areas.map((a) => (
          <li class={a === "Birmingham" ? "home" : ""}>{a}</li>
        ))}
      </ul>
      <p class="areas-note rv">
        Somewhere else nearby? <a href={phoneHref}>Call {phoneLabel}</a>. If
        you are in the West Midlands, we can probably reach you.
      </p>
    </div>
  </section>

  <!-- ============ REVIEWS ============ -->
  <!-- PLACEHOLDER REVIEWS: illustrative only. Client to replace with real Google reviews before launch. -->
  <section class="sec" id="reviews">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>Reviews</span>
        <h2>Rated 5.0 by Birmingham drivers.</h2>
        <p class="lead">
          What customers say after the rescue.
        </p>
      </div>
      <div class="rev-grid">
        <article class="rev rv">
          <div class="stars" aria-label="5 out of 5 stars">
            {[0,1,2,3,4].map(() => (
              <svg viewBox="0 0 24 24"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z" /></svg>
            ))}
          </div>
          <blockquote>
            "Battery died at 11pm in a supermarket car park. They were there in
            40 minutes, had me started in five, and checked the battery for
            free. Lifesavers."
          </blockquote>
          <div class="who">
            <span class="ava" aria-hidden="true">S</span>
            <div><strong>Sarah M.</strong><span class="loc">Kings Heath</span></div>
          </div>
        </article>
        <article class="rev rv rv-d1">
          <div class="stars" aria-label="5 out of 5 stars">
            {[0,1,2,3,4].map(() => (
              <svg viewBox="0 0 24 24"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z" /></svg>
            ))}
          </div>
          <blockquote>
            "Quoted me the price on the phone and stuck to it. No membership,
            no upsell, just a proper job done fast. Cannot ask for more than
            that."
          </blockquote>
          <div class="who">
            <span class="ava" aria-hidden="true">D</span>
            <div><strong>Dave P.</strong><span class="loc">Solihull</span></div>
          </div>
        </article>
        <article class="rev rv rv-d2">
          <div class="stars" aria-label="5 out of 5 stars">
            {[0,1,2,3,4].map(() => (
              <svg viewBox="0 0 24 24"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z" /></svg>
            ))}
          </div>
          <blockquote>
            "My van would not start before a big job at 6am. They came out,
            got me moving, and saved my whole week. Proper local service."
          </blockquote>
          <div class="who">
            <span class="ava" aria-hidden="true">A</span>
            <div><strong>Aisha K.</strong><span class="loc">Erdington</span></div>
          </div>
        </article>
      </div>
      <p class="rev-flag rv">
        Sample reviews shown. Real Google reviews will replace these before launch.
      </p>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="sec" id="faq">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>FAQ</span>
        <h2>Questions drivers ask us.</h2>
        <p class="lead">
          The things every stranded driver asks, answered straight, the way
          we would answer on the phone.
        </p>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <div class={`faq rv ${i % 3 === 1 ? "rv-d1" : i % 3 === 2 ? "rv-d2" : ""}`}>
            <button aria-expanded="false" aria-controls={`faq-a-${i}`} id={`faq-q-${i}`}>
              <span>{f.q}</span>
              <span class="plus" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </button>
            <div class="a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
              <div class="a-in">
                <p>{f.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="final">
    <div class="in rv">
      <h2>Still stuck? One call fixes it.</h2>
      <p>
        Call now and a real person answers. We dispatch help straight away,
        usually reaching you within 30 to 40 minutes.
      </p>
      <div class="row">
        <a href={phoneHref} class="btn btn-black">
          Call {phoneLabel}
          <span class="arr-c" set:html={arrow} />
        </a>
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-white">
          WhatsApp us
          <span class="arr-c" set:html={arrow} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
