---
import BaseLayout from "../layouts/BaseLayout.astro";

const phoneHref = "tel:+447477649906";
const phoneLabel = "07477 649906";
const waHref =
  "https://wa.me/447477649906?text=Hi%20Birmingham%20Jump%20Start%2C%20I%20need%20help.";

const arrow =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>';
---

<BaseLayout
  title="Contact Us | Birmingham Jump Start | 24/7 Phone and WhatsApp"
  description="Contact Birmingham Jump Start any time, day or night. Call 07477 649906 or WhatsApp us for jump starts, towing and recovery across Birmingham."
  path="contact/"
>
  <!-- ============ HERO ============ -->
  <section class="hero" id="top">
    <div class="wrap">
      <span class="eyebrow rv"><span class="dot"></span>Contact us</span>
      <h1 class="rv rv-d1">
        One call, <span class="hl">help on the way</span>.
      </h1>
      <p class="sub rv rv-d2">
        Day or night, a real person answers. Tell us where you are and what
        happened, and we will give you a fixed quote and an honest arrival
        time, usually within 30 to 40 minutes.
      </p>
      <div class="hero-ctas rv rv-d2">
        <a href={phoneHref} class="btn btn-yellow">
          Call {phoneLabel}
          <span class="arr-c" set:html={arrow} />
        </a>
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-white">
          WhatsApp us
          <span class="arr-c" set:html={arrow} />
        </a>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT CARDS ============ -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>Get in touch</span>
        <h2>Every way to reach us.</h2>
      </div>
      <div class="why-grid">
        <article class="why-card w-white rv">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z" /></svg>
          </span>
          <h3>Call us</h3>
          <p>
            <a href={phoneHref}>{phoneLabel}</a><br />
            Answered 24/7 by a real person. Fastest for emergencies.
          </p>
        </article>
        <article class="why-card w-yellow rv rv-d1">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.2 14.2a1.7 1.7 0 0 1-1.2.5c-.3 0-.7-.1-2.3-.9-2-1-3.2-2.2-3.6-2.6-.5-.4-.8-1-.4-1.6l.9-1.2c.3-.4.4-.9.1-1.2L9.4 7.6c-.4-.9-1-1-1.5-.9l-1.3.2c-.5.1-1.2.6-1.2 1.9 0 1.2 1.2 3.4 2.7 5.2 1.9 2.3 4 3.4 5.4 3.7 1.2.3 1.9 0 2.3-.5l1-1.3c.4-.5.3-1-.2-1.5z" /></svg>
          </span>
          <h3>WhatsApp</h3>
          <p>
            <a href={waHref} target="_blank" rel="noopener">Message us on WhatsApp</a><br />
            Handy for sharing your exact location pin.
          </p>
        </article>
        <article class="why-card w-black rv">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5z" /></svg>
          </span>
          <h3>Where we work</h3>
          <p>
            Birmingham and the West Midlands: Walsall, Coventry, Solihull,
            Tamworth, Sutton Coldfield and everywhere between.
          </p>
        </article>
        <article class="why-card w-white rv rv-d1">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z" /></svg>
          </span>
          <h3>Opening hours</h3>
          <p>
            24 hours a day, 7 days a week.<br />
            Nights, weekends and bank holidays included.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="final">
    <div class="in rv">
      <h2>Need help right now?</h2>
      <p>
        Call and we will dispatch help straight away, usually reaching you
        within 30 to 40 minutes.
      </p>
      <div class="row">
        <a href={phoneHref} class="btn btn-black">
          Call {phoneLabel}
          <span class="arr-c" set:html={arrow} />
        </a>
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-white">
          WhatsApp us
          <span class="arr-c" set:html={arrow} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
