---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Cookie Policy | Birmingham Jump Start"
  description="How Birmingham Jump Start uses cookies on this website and how you can control them."
  path="cookies/"
>
  <section class="hero hero-slim" id="top">
    <div class="wrap">
      <span class="eyebrow rv"><span class="dot"></span>Legal</span>
      <h1 class="rv rv-d1">Cookie Policy</h1>
      <p class="sub rv rv-d2">Last updated: 15 October 2026</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <article class="legal rv">
        <h2>What cookies are</h2>
        <p>Cookies are small text files stored on your device when you visit a website. They help websites remember things and understand how visitors use them.</p>
        <h2>How we use cookies</h2>
        <p>This website uses a small number of cookies: strictly necessary cookies that make the site work (for example remembering your menu state), and anonymous analytics cookies that help us understand which pages visitors find useful. We do not use advertising or tracking cookies.</p>
        <h2>Managing cookies</h2>
        <p>You can block or delete cookies in your browser settings at any time. Blocking strictly necessary cookies may stop parts of the site working properly.</p>
        <h2>Changes</h2>
        <p>If we change how we use cookies, we will update this page. Last updated: 15 October 2026.</p>
      </article>
    </div>
  </section>
</BaseLayout>
