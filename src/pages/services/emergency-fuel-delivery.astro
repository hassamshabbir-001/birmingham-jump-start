---
import BaseLayout from "../../layouts/BaseLayout.astro";

const phoneHref = "tel:+447477649906";
const phoneLabel = "07477 649906";
const waHref =
  "https://wa.me/447477649906?text=Hi%20Birmingham%20Jump%20Start%2C%20I%20need%20help.";

const arrow =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>';

const faqs = [
  {
    q: "How much fuel do you bring?",
    a: "Enough to get you comfortably to the nearest petrol station. Tell us petrol or diesel when you call.",
  },
  {
    q: "What if I put the wrong fuel in?",
    a: "Do not start the engine. Call us and we will advise; a fuel drain can be arranged through our recovery service.",
  },
  {
    q: "Do you come to motorways?",
    a: "Yes. We deliver on motorways, dual carriageways and rural roads across the West Midlands, where it is safe and legal to stop.",
  },
  {
    q: "How fast is delivery?",
    a: "Usually within 30 to 40 minutes of your call in Birmingham. We confirm the time on the phone.",
  },
  {
    q: "Is it legal to carry fuel like this?",
    a: "Yes, when handled correctly in approved containers by someone trained, which is exactly what we do.",
  },
  {
    q: "Can you bring diesel for a van?",
    a: "Yes. Cars, vans and light commercial vehicles, petrol or diesel.",
  },
];

const serviceJsonLd = {"@context": "https://schema.org", "@type": "Service", "serviceType": "Emergency Fuel Delivery", "name": "Emergency Fuel Delivery in Birmingham", "description": "24/7 emergency petrol and diesel delivery in Birmingham, usually within 30 to 40 minutes of your call.", "provider": {"@type": "AutoRepair", "@id": "https://birminghamjumpstart.co.uk/#business", "name": "Birmingham Jump Start", "telephone": "+447477649906"}, "areaServed": [{"@type": "City", "name": "Birmingham"}, {"@type": "City", "name": "Walsall"}, {"@type": "City", "name": "Coventry"}, {"@type": "City", "name": "Solihull"}, {"@type": "City", "name": "Tamworth"}, {"@type": "City", "name": "Sutton Coldfield"}], "availableChannel": {"@type": "ServiceChannel", "servicePhone": {"@type": "ContactPoint", "telephone": "+447477649906", "contactType": "emergency", "availableLanguage": "en-GB"}}, "hoursAvailable": {"@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"], "opens": "00:00", "closes": "23:59"}};
---

<BaseLayout
  title="Emergency Fuel Delivery Birmingham | Petrol and Diesel 24/7"
  description="Out of fuel in Birmingham? We deliver petrol or diesel to your car, usually within 30 to 40 minutes. Fixed quote, no membership. Call 07477 649906."
  path="services/emergency-fuel-delivery/"
  faq={faqs}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />

  <!-- ============ HERO ============ -->
  <section class="hero" id="top">
    <div class="wrap">
      <span class="eyebrow rv"><span class="dot"></span>Emergency fuel delivery Birmingham, 24/7</span>
      <h1 class="rv rv-d1">
        Out of fuel? <span class="hl">We bring it</span> to you.
      </h1>
      <p class="sub rv rv-d2">
        Empty tank at the roadside, at work or on the driveway. We deliver petrol or diesel straight to your car, enough to reach the nearest station. Faster and far safer than walking along a busy road.
      </p>
      <div class="hero-ctas rv rv-d2">
        <a href={phoneHref} class="btn btn-yellow">
          Call {phoneLabel}
          <span class="arr-c" set:html={arrow} />
        </a>
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-white">
          WhatsApp us
          <span class="arr-c" set:html={arrow} />
        </a>
      </div>
      <p class="hero-eta rv rv-d2">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z" /></svg>
        At your car within 30 to 40 minutes of your call
      </p>
    </div>
    <div class="hero-photo rv">
      <div class="ph">
        <img
          src="/images/emergency-fuel-delivery-birmingham.webp?v=2"
          alt="Birmingham Jump Start technician pouring emergency fuel from a jerry can beside the branded van"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1200"
          height="800"
        />
      </div>
      <div class="hero-floats">
        <div class="float-card fc-1">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5z" /></svg>
          </span>
          <div>
            <strong>We come to you</strong>
            <span>Roadside, car park or driveway</span>
          </div>
        </div>
        <div class="float-card fc-2">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z" /></svg>
          </span>
          <div>
            <strong>30 to 40 minutes</strong>
            <span>Usual response in Birmingham</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BLACK BAND ============ -->
  <section class="band-black" aria-label="Fuel delivery facts">
    <div class="wrap">
      <div class="sec-head center rv">
        <span class="eyebrow on-dark"><span class="dot"></span>Why drivers call us</span>
        <h2>Fuel in the tank, fast.</h2>
        <p class="lede">
          Enough fuel to get you to the nearest station, delivered safely and legally by a trained technician, day or night.
        </p>
      </div>
      <ul class="chips rv">
        {["30 to 40 minute response", "Petrol and diesel", "Enough to reach a station", "Motorways covered", "Fixed quote on the phone"].map((c) => (
          <li><i aria-hidden="true"></i>{c}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ SIGNS ============ -->
  <section class="sec" id="signs">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>Do you need fuel delivered?</span>
        <h2>When the tank runs dry.</h2>
        <p class="lead">
          It happens to careful drivers too: misjudged distance, broken fuel gauge, or a diversion that ate the reserve.
        </p>
      </div>
      <div class="why-grid">
                <article class="why-card w-white rv">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 1 0 0 20 10 10 0 0 0 0-20zm-1 4h2v6h-2zm0 8h2v2h-2z" /></svg>
          </span>
          <h3>Fuel light was optimistic.</h3>
          <p>
            The range display said 20 miles and the station was 25 away. We have all been there.
          </p>
        </article>
        <article class="why-card w-yellow rv rv-d1">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5z" /></svg>
          </span>
          <h3>Stranded somewhere remote.</h3>
          <p>
            Country lane late at night with no station in sight. Walking is not a safe option.
          </p>
        </article>
        <article class="why-card w-black rv">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 1 0 0 20 10 10 0 0 0 0-20zm-1 4h2v6h-2zm0 8h2v2h-2z" /></svg>
          </span>
          <h3>Wrong fuel in the tank.</h3>
          <p>
            Petrol in a diesel or diesel in a petrol. Do not start the engine and call us; we will advise on a fuel drain.
          </p>
        </article>
        <article class="why-card w-white rv rv-d1">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z" /></svg>
          </span>
          <h3>No time to wait.</h3>
          <p>
            Meeting, school run, shift starting. A delivery is faster than arranging a lift to a station and back.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ WHAT'S INCLUDED ============ -->
  <section class="sec" id="included">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>What you get</span>
        <h2>Delivered safely, legally.</h2>
        <p class="lead">
          Fuel is hazardous, which is why it should be handled by someone trained, with the right containers and procedures.
        </p>
      </div>
      <div class="duo">
        <div class="duo-card duo-white rv">
          <div class="ph">
            <img
              src="/images/emergency-fuel-delivery-birmingham.webp?v=2"
              alt="Emergency fuel being delivered to a car at the roadside in Birmingham"
              loading="lazy"
              decoding="async"
              width="1200"
              height="800"
            />
          </div>
        </div>
        <div class="duo-card duo-black rv rv-d1">
          <div>
            <h3>Every visit includes</h3>
            <ul class="tick-list">
              <li>Petrol or diesel delivered to your exact location</li>
              <li>Enough fuel to reach the nearest filling station</li>
              <li>Safe handling by a trained technician</li>
              <li>Available 24/7, including motorways and rural roads</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ YELLOW BAND ============ -->
  <section class="band-yellow" aria-label="Fuel delivery cost">
    <div class="in">
      <div class="wrap">
        <span class="eyebrow on-yellow rv"><span class="dot"></span>What it costs</span>
        <h2 class="rv rv-d1">Fixed quote, fuel included.</h2>
        <p class="lede rv rv-d1">
          One fixed price on the phone covers the callout and the fuel delivered. No membership, no hidden extras, no night surcharge. The price we quote is the price you pay.
        </p>
        <div class="steps-cta rv">
          <a href={phoneHref} class="btn btn-black">
            Call 07477 649906 for your quote
            <span class="arr-c" set:html={arrow} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="sec" id="how">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>How it works</span>
        <h2>From your call to moving again.</h2>
      </div>
      <div class="steps">
        <article class="step rv">
          <span class="num">01</span>
          <h3>You call.</h3>
          <p>
            One number, answered 24/7 by a real person. Tell us your location
            and what happened.
          </p>
        </article>
        <article class="step rv rv-d1">
          <span class="num">02</span>
          <h3>Fixed quote.</h3>
          <p>
            We agree the price on the phone before we set off. It will not
            change when we arrive.
          </p>
        </article>
        <article class="step rv rv-d2">
          <span class="num">03</span>
          <h3>We come to you.</h3>
          <p>
            The nearest technician heads straight to you, usually within 30 to
            40 minutes, with an honest arrival time.
          </p>
        </article>
        <article class="step rv">
          <span class="num">04</span>
          <h3>Fuelled and moving.</h3>
          <p>
            Fuel in the tank, engine started, and you are on your way to fill up properly.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ AREAS ============ -->
  <section class="sec" id="areas">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>Areas we cover</span>
        <h2>Wherever you are in Birmingham, we are close.</h2>
        <p class="lead">
          Local technicians across Birmingham and the West Midlands, on roads
          we know well: the M6, M42, A38 and A45 corridors, the Bullring, the
          NEC, Birmingham Airport and every suburb between.
        </p>
      </div>
      <ul class="chips rv">
        {["Birmingham City Centre", "Edgbaston", "Erdington", "Sutton Coldfield", "Handsworth", "Harborne", "Yardley", "Solihull", "Walsall", "Coventry", "Tamworth", "Kings Heath", "Selly Oak", "Aston", "Birmingham Airport", "The NEC"].map((c) => (
          <li><i aria-hidden="true"></i>{c}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="sec" id="faq">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>FAQ</span>
        <h2>Fuel delivery questions, answered.</h2>
        <p class="lead">
          The things every driver asks, answered straight, the way
          we would answer on the phone.
        </p>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <div class={`faq rv ${i % 3 === 1 ? "rv-d1" : i % 3 === 2 ? "rv-d2" : ""}`}>
            <button aria-expanded="false" aria-controls={`faq-a-${i}`} id={`faq-q-${i}`}>
              <span>{f.q}</span>
              <span class="plus" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </button>
            <div class="a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
              <div class="a-in">
                <p>{f.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="final">
    <div class="in rv">
      <h2>Out of fuel? One call fixes it.</h2>
      <p>
        Call now and a real person answers. We dispatch help straight away,
        usually reaching you within 30 to 40 minutes.
      </p>
      <div class="row">
        <a href={phoneHref} class="btn btn-black">
          Call {phoneLabel}
          <span class="arr-c" set:html={arrow} />
        </a>
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-white">
          WhatsApp us
          <span class="arr-c" set:html={arrow} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
