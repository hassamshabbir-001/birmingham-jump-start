---
import BaseLayout from "../../layouts/BaseLayout.astro";

const phoneHref = "tel:+447477649906";
const phoneLabel = "07477 649906";
const waHref =
  "https://wa.me/447477649906?text=Hi%20Birmingham%20Jump%20Start%2C%20I%20need%20help.";

const arrow =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>';

const faqs = [
  {
    q: "What areas do you cover?",
    a: "Birmingham and the whole West Midlands: Walsall, Coventry, Solihull, Tamworth, Sutton Coldfield and everywhere between, 24 hours a day.",
  },
  {
    q: "Will you try to fix it at the roadside first?",
    a: "Yes. If it is a battery, fuel, tyre or lockout issue we fix it there. If not, we recover the car.",
  },
  {
    q: "Can you take passengers too?",
    a: "Yes. You ride with us in the cab, so nobody is stranded at the roadside.",
  },
  {
    q: "How much does recovery cost?",
    a: "A fixed quote on the phone before we set off, based on the job and distance. No membership, no surprise extras.",
  },
  {
    q: "What if I break down on the motorway?",
    a: "We attend motorways across the region. Get to a safe place, hazards on, and call us.",
  },
  {
    q: "How fast can you reach me?",
    a: "Usually within 30 to 40 minutes of your call in Birmingham. We confirm the time on the phone.",
  },
];

const serviceJsonLd = {"@context": "https://schema.org", "@type": "Service", "serviceType": "Vehicle Breakdown Recovery", "name": "Breakdown Recovery in Birmingham", "description": "24/7 breakdown recovery in Birmingham and the West Midlands. You and your vehicle recovered together, usually within 30 to 40 minutes.", "provider": {"@type": "AutoRepair", "@id": "https://www.birminghamjumpstart.co.uk/#business", "name": "Birmingham Jump Start", "telephone": "+447477649906"}, "areaServed": [{"@type": "City", "name": "Birmingham"}, {"@type": "City", "name": "Walsall"}, {"@type": "City", "name": "Coventry"}, {"@type": "City", "name": "Solihull"}, {"@type": "City", "name": "Tamworth"}, {"@type": "City", "name": "Sutton Coldfield"}], "availableChannel": {"@type": "ServiceChannel", "servicePhone": {"@type": "ContactPoint", "telephone": "+447477649906", "contactType": "emergency", "availableLanguage": "en-GB"}}, "hoursAvailable": {"@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"], "opens": "00:00", "closes": "23:59"}};
---

<BaseLayout
  heroImage="/images/car-breakdown-recovery-birmingham.webp"
  title="Breakdown Recovery Birmingham | 24/7 Car Recovery Service"
  description="Broken down in Birmingham? We recover you and your vehicle day or night, usually within 30 to 40 minutes. Fixed quote. Call 07477 649906."
  path="services/breakdown-recovery/"
  faq={faqs}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />

  <!-- ============ HERO ============ -->
  <section class="hero" id="top">
    <div class="wrap">
      <span class="eyebrow rv"><span class="dot"></span>Breakdown recovery Birmingham, 24/7</span>
      <h1 class="rv rv-d1">
        Broken down? <span class="hl">We bring you</span> home.
      </h1>
      <p class="sub rv rv-d2">
        Any breakdown, anywhere in the West Midlands, day or night. We recover you and the vehicle together, so nobody is left at the roadside.
      </p>
      <div class="hero-ctas rv rv-d2">
        <a href={phoneHref} class="btn btn-yellow">
          Call {phoneLabel}
          <span class="arr-c" set:html={arrow} />
        </a>
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-white">
          WhatsApp us
          <span class="arr-c" set:html={arrow} />
        </a>
      </div>
      <p class="hero-eta rv rv-d2">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z" /></svg>
        At your car within 30 to 40 minutes of your call
      </p>
    </div>
    <div class="hero-photo rv">
      <div class="ph">
        <img
          src="/images/car-breakdown-recovery-birmingham.webp"
          srcset="/images/car-breakdown-recovery-birmingham-mobile.webp 640w, /images/car-breakdown-recovery-birmingham.webp 1280w"
          sizes="(max-width: 640px) 640px, 1280px"
          alt="BMW being secured on a Birmingham Jump Start flatbed recovery truck at sunset"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1200"
          height="800"
        />
      </div>
      <div class="hero-floats">
        <div class="float-card fc-1">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5z" /></svg>
          </span>
          <div>
            <strong>You ride with us</strong>
            <span>Nobody left at the roadside</span>
          </div>
        </div>
        <div class="float-card fc-2">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z" /></svg>
          </span>
          <div>
            <strong>30 to 40 minutes</strong>
            <span>Usual response in Birmingham</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BLACK BAND ============ -->
  <section class="band-black" aria-label="Recovery facts">
    <div class="wrap">
      <div class="sec-head center rv">
        <span class="eyebrow on-dark"><span class="dot"></span>Why drivers call us</span>
        <h2>You and the car, recovered together.</h2>
        <p class="lede">
          One team handles the whole job: diagnosis at the roadside, recovery if it cannot be fixed, and you dropped where you need to be.
        </p>
      </div>
      <ul class="chips rv">
        {["30 to 40 minute response", "You and car together", "Roadside fix attempted first", "24/7, every day", "Fixed quote on the phone"].map((c) => (
          <li><i aria-hidden="true"></i>{c}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ SIGNS ============ -->
  <section class="sec" id="signs">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>Do you need recovery?</span>
        <h2>When recovery is the answer.</h2>
        <p class="lead">
          Some breakdowns end at the roadside. When yours does, we take it from there.
        </p>
      </div>
      <div class="why-grid">
                <article class="why-card w-white rv">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 1 0 0 20 10 10 0 0 0 0-20zm-1 4h2v6h-2zm0 8h2v2h-2z" /></svg>
          </span>
          <h3>Complete breakdown.</h3>
          <p>
            Engine dead, electrics dead, nothing responds. The car needs a truck, not a jump pack.
          </p>
        </article>
        <article class="why-card w-yellow rv rv-d1">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 1 0 0 20 10 10 0 0 0 0-20zm-1 4h2v6h-2zm0 8h2v2h-2z" /></svg>
          </span>
          <h3>Overheating.</h3>
          <p>
            Temperature gauge in the red, steam, warning lights. Driving on will wreck the engine.
          </p>
        </article>
        <article class="why-card w-black rv">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 1 0 0 20 10 10 0 0 0 0-20zm-1 4h2v6h-2zm0 8h2v2h-2z" /></svg>
          </span>
          <h3>Serious mechanical failure.</h3>
          <p>
            Gearbox, clutch, suspension or steering failure. Unsafe to drive and unsafe to leave.
          </p>
        </article>
        <article class="why-card w-white rv rv-d1">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 1 0 0 20 10 10 0 0 0 0-20zm-1 4h2v6h-2zm0 8h2v2h-2z" /></svg>
          </span>
          <h3>Breakdown at night.</h3>
          <p>
            Dark, raining, middle of nowhere. You and your passengers need to be somewhere safe, fast.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ WHAT'S INCLUDED ============ -->
  <section class="sec" id="included">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>What you get</span>
        <h2>Recovered properly, together.</h2>
        <p class="lead">
          Nobody left behind, nothing left to chance.
        </p>
      </div>
      <div class="duo">
        <div class="duo-card duo-white rv">
          <div class="ph">
            <img
              src="/images/car-breakdown-recovery-birmingham.webp"
          srcset="/images/car-breakdown-recovery-birmingham-mobile.webp 640w, /images/car-breakdown-recovery-birmingham.webp 1280w"
          sizes="(max-width: 640px) 640px, 1280px"
              alt="Car secured on a Birmingham Jump Start flatbed truck"
              loading="lazy"
              decoding="async"
              width="1200"
              height="800"
            />
          </div>
        </div>
        <div class="duo-card duo-black rv rv-d1">
          <div>
            <h3>Every visit includes</h3>
            <ul class="tick-list">
              <li>Full breakdown recovery across the West Midlands</li>
              <li>You ride with us in the cab, nobody left behind</li>
              <li>Roadside fix attempted first where possible</li>
              <li>Onward travel arranged if the car must go to a garage</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ YELLOW BAND ============ -->
  <section class="band-yellow" aria-label="Recovery cost">
    <div class="in">
      <div class="wrap">
        <span class="eyebrow on-yellow rv"><span class="dot"></span>What it costs</span>
        <h2 class="rv rv-d1">Fixed quote based on the job.</h2>
        <p class="lede rv rv-d1">
          Tell us what happened and where the car needs to go, and we quote a fixed price on the phone before we set off. No membership, no hidden extras, no night surcharge. The price we quote is the price you pay.
        </p>
        <div class="steps-cta rv">
          <a href={phoneHref} class="btn btn-black">
            Call 07477 649906 for your quote
            <span class="arr-c" set:html={arrow} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="sec" id="how">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>How it works</span>
        <h2>From your call to moving again.</h2>
      </div>
      <div class="steps">
        <article class="step rv">
          <span class="num">01</span>
          <h3>You call.</h3>
          <p>
            One number, answered 24/7 by a real person. Tell us your location
            and what happened.
          </p>
        </article>
        <article class="step rv rv-d1">
          <span class="num">02</span>
          <h3>Fixed quote.</h3>
          <p>
            We agree the price on the phone before we set off. It will not
            change when we arrive.
          </p>
        </article>
        <article class="step rv rv-d2">
          <span class="num">03</span>
          <h3>We come to you.</h3>
          <p>
            The nearest technician heads straight to you, usually within 30 to
            40 minutes, with an honest arrival time.
          </p>
        </article>
        <article class="step rv">
          <span class="num">04</span>
          <h3>Recovered and home.</h3>
          <p>
            Car secured on the truck, you in the cab, dropped at your home or chosen garage.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ AREAS ============ -->
  <section class="sec" id="areas">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>Areas we cover</span>
        <h2>Wherever you are in Birmingham, we are close.</h2>
        <p class="lead">
          Local technicians across Birmingham and the West Midlands, on roads
          we know well: the M6, M42, A38 and A45 corridors, the Bullring, the
          NEC, Birmingham Airport and every suburb between.
        </p>
      </div>
      <ul class="chips rv">
        {["Birmingham City Centre", "Edgbaston", "Erdington", "Sutton Coldfield", "Handsworth", "Harborne", "Yardley", "Solihull", "Walsall", "Coventry", "Tamworth", "Kings Heath", "Selly Oak", "Aston", "Birmingham Airport", "The NEC"].map((c) => (
          <li><i aria-hidden="true"></i>{c}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="sec" id="faq">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>FAQ</span>
        <h2>Recovery questions, answered.</h2>
        <p class="lead">
          The things every driver asks, answered straight, the way
          we would answer on the phone.
        </p>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <div class={`faq rv ${i % 3 === 1 ? "rv-d1" : i % 3 === 2 ? "rv-d2" : ""}`}>
            <button aria-expanded="false" aria-controls={`faq-a-${i}`} id={`faq-q-${i}`}>
              <span>{f.q}</span>
              <span class="plus" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </button>
            <div class="a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
              <div class="a-in">
                <p>{f.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="final">
    <div class="in rv">
      <h2>Broken down? One call fixes it.</h2>
      <p>
        Call now and a real person answers. We dispatch help straight away,
        usually reaching you within 30 to 40 minutes.
      </p>
      <div class="row">
        <a href={phoneHref} class="btn btn-black">
          Call {phoneLabel}
          <span class="arr-c" set:html={arrow} />
        </a>
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-white">
          WhatsApp us
          <span class="arr-c" set:html={arrow} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
