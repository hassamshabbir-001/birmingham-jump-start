---
import BaseLayout from "../../layouts/BaseLayout.astro";

const phoneHref = "tel:+447477649906";
const phoneLabel = "07477 649906";
const waHref =
  "https://wa.me/447477649906?text=Hi%20Birmingham%20Jump%20Start%2C%20I%20need%20help.";

const arrow =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>';

const faqs = [
  {
    q: "How fast can you tow my car?",
    a: "Usually within 30 to 40 minutes of your call in Birmingham. We confirm the arrival time on the phone.",
  },
  {
    q: "Where can you take my car?",
    a: "Anywhere you choose: your home, a garage, a dealership or an auction site, across Birmingham and the West Midlands.",
  },
  {
    q: "Can you tow accident-damaged cars?",
    a: "Yes. We recover accident and non-runner vehicles with the right equipment to avoid further damage.",
  },
  {
    q: "Can passengers ride with you?",
    a: "Yes. You ride in the cab with us, so nobody is left at the roadside.",
  },
  {
    q: "What if my car is in a tight spot?",
    a: "Tell us when you call. We have wheel-lift and flatbed options and will send the right truck for the access.",
  },
  {
    q: "Do I need to be with the car?",
    a: "It helps, but if you cannot stay, we can arrange collection with the keys left in an agreed safe place.",
  },
];

const serviceJsonLd = {"@context": "https://schema.org", "@type": "Service", "serviceType": "Vehicle Towing", "name": "Car Towing and Recovery in Birmingham", "description": "24/7 car towing and recovery in Birmingham and the West Midlands, usually within 30 to 40 minutes of your call.", "provider": {"@type": "AutoRepair", "@id": "https://www.birminghamjumpstart.co.uk/#business", "name": "Birmingham Jump Start", "telephone": "+447477649906"}, "areaServed": [{"@type": "City", "name": "Birmingham"}, {"@type": "City", "name": "Walsall"}, {"@type": "City", "name": "Coventry"}, {"@type": "City", "name": "Solihull"}, {"@type": "City", "name": "Tamworth"}, {"@type": "City", "name": "Sutton Coldfield"}], "availableChannel": {"@type": "ServiceChannel", "servicePhone": {"@type": "ContactPoint", "telephone": "+447477649906", "contactType": "emergency", "availableLanguage": "en-GB"}}, "hoursAvailable": {"@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"], "opens": "00:00", "closes": "23:59"}};
---

<BaseLayout
  heroImage="/images/tow-truck-loading-car-birmingham.webp"
  title="Car Towing Birmingham | 24/7 Towing and Recovery Service"
  description="Need a tow in Birmingham? We recover your car safely to your home or garage, usually within 30 to 40 minutes. Fixed quote on the phone. Call 07477 649906."
  path="services/towing-and-recovery/"
  faq={faqs}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />

  <!-- ============ HERO ============ -->
  <section class="hero" id="top">
    <div class="wrap">
      <span class="eyebrow rv"><span class="dot"></span>Towing and recovery Birmingham, 24/7</span>
      <h1 class="rv rv-d1">
        Car not moving? <span class="hl">Towed safely</span> where it needs to go.
      </h1>
      <p class="sub rv rv-d2">
        Breakdown, accident or a car that simply will not start: we tow it safely to your home, your garage or wherever it needs to go, anywhere in Birmingham and the West Midlands.
      </p>
      <div class="hero-ctas rv rv-d2">
        <a href={phoneHref} class="btn btn-yellow">
          Call {phoneLabel}
          <span class="arr-c" set:html={arrow} />
        </a>
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-white">
          WhatsApp us
          <span class="arr-c" set:html={arrow} />
        </a>
      </div>
      <p class="hero-eta rv rv-d2">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z" /></svg>
        At your car within 30 to 40 minutes of your call
      </p>
    </div>
    <div class="hero-photo rv">
      <div class="ph">
        <img
          src="/images/tow-truck-loading-car-birmingham.webp"
          srcset="/images/tow-truck-loading-car-birmingham-mobile.webp 640w, /images/tow-truck-loading-car-birmingham.webp 1280w"
          sizes="(max-width: 640px) 640px, 1280px"
          alt="Birmingham Jump Start tow truck loading an SUV at dusk with the Birmingham skyline behind"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1200"
          height="800"
        />
      </div>
      <div class="hero-floats">
        <div class="float-card fc-1">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M22.7 19l-9.1-9.1a4.5 4.5 0 0 0-6 6L2 21.5V24h2.5l5.6-5.6a4.5 4.5 0 0 0 6-6l4.6 4.6a1.8 1.8 0 0 0 2.5-2.5z" /></svg>
          </span>
          <div>
            <strong>Secure loading</strong>
            <span>Wheel-lift and flatbed options</span>
          </div>
        </div>
        <div class="float-card fc-2">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z" /></svg>
          </span>
          <div>
            <strong>30 to 40 minutes</strong>
            <span>Usual response in Birmingham</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BLACK BAND ============ -->
  <section class="band-black" aria-label="Towing facts">
    <div class="wrap">
      <div class="sec-head center rv">
        <span class="eyebrow on-dark"><span class="dot"></span>Why drivers call us</span>
        <h2>Recovery without the drama.</h2>
        <p class="lede">
          Modern equipment, trained operators, and your car treated carefully from pickup to drop-off. You choose the destination.
        </p>
      </div>
      <ul class="chips rv">
        {["30 to 40 minute response", "Your choice of destination", "Accident recovery", "You ride with us", "Fixed quote on the phone"].map((c) => (
          <li><i aria-hidden="true"></i>{c}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ SIGNS ============ -->
  <section class="sec" id="signs">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>Do you need a tow?</span>
        <h2>When towing is the answer.</h2>
        <p class="lead">
          Some problems cannot be fixed at the roadside. When that happens, safe recovery is the right call.
        </p>
      </div>
      <div class="why-grid">
                <article class="why-card w-white rv">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 1 0 0 20 10 10 0 0 0 0-20zm-1 4h2v6h-2zm0 8h2v2h-2z" /></svg>
          </span>
          <h3>Car will not start at all.</h3>
          <p>
            No crank, no lights, jump start did not help. The fault needs a garage, and the car needs a tow.
          </p>
        </article>
        <article class="why-card w-yellow rv rv-d1">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M22.7 19l-9.1-9.1a4.5 4.5 0 0 0-6 6L2 21.5V24h2.5l5.6-5.6a4.5 4.5 0 0 0 6-6l4.6 4.6a1.8 1.8 0 0 0 2.5-2.5z" /></svg>
          </span>
          <h3>Accident damage.</h3>
          <p>
            Even minor accident damage can make a car unsafe to drive. We recover it without causing further damage.
          </p>
        </article>
        <article class="why-card w-black rv">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 1 0 0 20 10 10 0 0 0 0-20zm-1 4h2v6h-2zm0 8h2v2h-2z" /></svg>
          </span>
          <h3>Engine or gearbox failure.</h3>
          <p>
            Warning lights, strange noises, loss of power. Driving on risks a bigger bill; a tow is cheaper than an engine.
          </p>
        </article>
        <article class="why-card w-white rv rv-d1">
          <span class="ic">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5z" /></svg>
          </span>
          <h3>Stuck somewhere unsafe.</h3>
          <p>
            Broken down on a busy road or in a bad spot at night. We get you and the car out safely.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ WHAT'S INCLUDED ============ -->
  <section class="sec" id="included">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>What you get</span>
        <h2>Handled properly, end to end.</h2>
        <p class="lead">
          From the first call to the drop-off, one team takes responsibility for your car.
        </p>
      </div>
      <div class="duo">
        <div class="duo-card duo-white rv">
          <div class="ph">
            <img
              src="/images/tow-truck-loading-car-birmingham.webp"
          srcset="/images/tow-truck-loading-car-birmingham-mobile.webp 640w, /images/tow-truck-loading-car-birmingham.webp 1280w"
          sizes="(max-width: 640px) 640px, 1280px"
              alt="Birmingham Jump Start branded tow truck ready for a towing job"
              loading="lazy"
              decoding="async"
              width="1200"
              height="800"
            />
          </div>
        </div>
        <div class="duo-card duo-black rv rv-d1">
          <div>
            <h3>Every visit includes</h3>
            <ul class="tick-list">
              <li>Local towing across Birmingham and the West Midlands</li>
              <li>Your choice of destination: home, garage or auction</li>
              <li>Accident and non-runner recovery</li>
              <li>Secure loading with wheel-lift and flatbed options</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ YELLOW BAND ============ -->
  <section class="band-yellow" aria-label="Towing cost">
    <div class="in">
      <div class="wrap">
        <span class="eyebrow on-yellow rv"><span class="dot"></span>What it costs</span>
        <h2 class="rv rv-d1">Fixed quote based on distance.</h2>
        <p class="lede rv rv-d1">
          Tell us where the car is and where it needs to go, and we quote a fixed price on the phone before we set off. No membership, no hidden extras, no night surcharge. The price we quote is the price you pay.
        </p>
        <div class="steps-cta rv">
          <a href={phoneHref} class="btn btn-black">
            Call 07477 649906 for your quote
            <span class="arr-c" set:html={arrow} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="sec" id="how">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>How it works</span>
        <h2>From your call to moving again.</h2>
      </div>
      <div class="steps">
        <article class="step rv">
          <span class="num">01</span>
          <h3>You call.</h3>
          <p>
            One number, answered 24/7 by a real person. Tell us your location
            and what happened.
          </p>
        </article>
        <article class="step rv rv-d1">
          <span class="num">02</span>
          <h3>Fixed quote.</h3>
          <p>
            We agree the price on the phone before we set off. It will not
            change when we arrive.
          </p>
        </article>
        <article class="step rv rv-d2">
          <span class="num">03</span>
          <h3>We come to you.</h3>
          <p>
            The nearest technician heads straight to you, usually within 30 to
            40 minutes, with an honest arrival time.
          </p>
        </article>
        <article class="step rv">
          <span class="num">04</span>
          <h3>Delivered safely.</h3>
          <p>
            Your car secured, transported and handed over at your chosen destination. You sign, we leave.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ AREAS ============ -->
  <section class="sec" id="areas">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>Areas we cover</span>
        <h2>Wherever you are in Birmingham, we are close.</h2>
        <p class="lead">
          Local technicians across Birmingham and the West Midlands, on roads
          we know well: the M6, M42, A38 and A45 corridors, the Bullring, the
          NEC, Birmingham Airport and every suburb between.
        </p>
      </div>
      <ul class="chips rv">
        {["Birmingham City Centre", "Edgbaston", "Erdington", "Sutton Coldfield", "Handsworth", "Harborne", "Yardley", "Solihull", "Walsall", "Coventry", "Tamworth", "Kings Heath", "Selly Oak", "Aston", "Birmingham Airport", "The NEC"].map((c) => (
          <li><i aria-hidden="true"></i>{c}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="sec" id="faq">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow"><span class="dot"></span>FAQ</span>
        <h2>Towing questions, answered.</h2>
        <p class="lead">
          The things every driver asks, answered straight, the way
          we would answer on the phone.
        </p>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <div class={`faq rv ${i % 3 === 1 ? "rv-d1" : i % 3 === 2 ? "rv-d2" : ""}`}>
            <button aria-expanded="false" aria-controls={`faq-a-${i}`} id={`faq-q-${i}`}>
              <span>{f.q}</span>
              <span class="plus" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </button>
            <div class="a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
              <div class="a-in">
                <p>{f.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="final">
    <div class="in rv">
      <h2>Need a tow? One call fixes it.</h2>
      <p>
        Call now and a real person answers. We dispatch help straight away,
        usually reaching you within 30 to 40 minutes.
      </p>
      <div class="row">
        <a href={phoneHref} class="btn btn-black">
          Call {phoneLabel}
          <span class="arr-c" set:html={arrow} />
        </a>
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-white">
          WhatsApp us
          <span class="arr-c" set:html={arrow} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
