---
import "../styles/global.css";

export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  faq?: FaqItem[];
  path?: string;
}

const { title, description, faq = [], path = "" } = Astro.props;

const siteUrl = "https://birminghamjumpstart.co.uk/";
const canonical = siteUrl + path;
const phoneHref = "tel:+447477649906";
const phoneLabel = "07477 649906";
const waHref = "https://wa.me/447477649906?text=Hi%20Birmingham%20Jump%20Start%2C%20I%20need%20a%20jump%20start.";

const businessJsonLd = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  "@id": siteUrl + "#business",
  name: "Birmingham Jump Start",
  description:
    "24/7 car jump start and vehicle recovery service in Birmingham and the West Midlands. Flat battery jump starts, towing, breakdown and accident recovery.",
  url: siteUrl,
  telephone: "+447477649906",
  priceRange: "££",
  image: siteUrl + "og-cover.jpg",
  areaServed: [
    { "@type": "City", name: "Birmingham" },
    { "@type": "City", name: "Walsall" },
    { "@type": "City", name: "Coventry" },
    { "@type": "City", name: "Solihull" },
    { "@type": "City", name: "Tamworth" },
    { "@type": "City", name: "Sutton Coldfield" },
  ],
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: "00:00",
    closes: "23:59",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5.0",
    reviewCount: "15",
  },
};

const faqJsonLd =
  faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      }
    : null;

const pathParts = path.split("/").filter(Boolean);
const breadcrumbJsonLd =
  pathParts.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: siteUrl,
          },
          ...pathParts.map((part, i) => ({
            "@type": "ListItem",
            position: i + 2,
            name: part
              .split("-")
              .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
              .join(" "),
            item: siteUrl + pathParts.slice(0, i + 1).join("/") + "/",
          })),
        ],
      }
    : null;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#fccc02" />
    <link rel="preload" as="image" href="/images/birmingham-jump-start-hero.webp" fetchpriority="high" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Birmingham Jump Start" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={siteUrl + "og-cover.jpg"} />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <noscript><style>.rv { opacity: 1 !important; transform: none !important; }</style></noscript>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(businessJsonLd)}
    />
    {
      faqJsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(faqJsonLd)}
        />
      )
    }
    {
      breadcrumbJsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbJsonLd)}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main" style="position:absolute;left:12px;top:-60px;z-index:100;background:#ffb800;color:#161006;padding:10px 18px;border-radius:8px;font-weight:700;">Skip to content</a>

    <!-- ============ NAV ============ -->
    <header class="nav" id="nav">
      <div class="nav-in">
        <a href="#top" class="wordmark" aria-label="Birmingham Jump Start home">
          <span class="bolt" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M13 2 4.5 13.5H11L9.5 22 19 10h-6.5L13 2z" /></svg>
          </span>
          <span>Birmingham Jump Start<small>24/7 Recovery</small></span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <div class="nav-drop">
            <a href="/services/" class="nav-drop-btn" aria-haspopup="true">
              Services
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
            </a>
            <div class="nav-drop-menu" role="menu" aria-label="Services">
              <a href="/services/" class="drop-all" role="menuitem">All Services</a>
              <a href="/services/jump-start/" role="menuitem">Jump Start</a>
              <a href="/services/battery-replacement/" role="menuitem">Battery Replacement</a>
              <a href="/services/towing-and-recovery/" role="menuitem">Towing and Recovery</a>
              <a href="/services/emergency-fuel-delivery/" role="menuitem">Emergency Fuel Delivery</a>
              <a href="/services/car-lockout/" role="menuitem">Car Lockout</a>
              <a href="/services/tyre-change/" role="menuitem">Tyre Change</a>
              <a href="/services/breakdown-recovery/" role="menuitem">Breakdown Recovery</a>
            </div>
          </div>
          <a href="/#how">How it works</a>
          <a href="/#areas">Areas</a>
          <a href="/#reviews">Reviews</a>
          <a href="/#faq">FAQ</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>
        <a href={phoneHref} class="btn btn-yellow btn-sm nav-cta">
          <span class="num">{phoneLabel}</span>
          <span class="arr-c" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </span>
        </a>
        <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false">
          <span></span>
        </button>
      </div>
    </header>

    <nav class="mobile-menu" id="mobileMenu" aria-label="Mobile">
      <a href="/services/" class="m-sec">All Services</a>
      <a href="/services/jump-start/" class="m-sub">Jump Start</a>
      <a href="/services/battery-replacement/" class="m-sub">Battery Replacement</a>
      <a href="/services/towing-and-recovery/" class="m-sub">Towing and Recovery</a>
      <a href="/services/emergency-fuel-delivery/" class="m-sub">Emergency Fuel Delivery</a>
      <a href="/services/car-lockout/" class="m-sub">Car Lockout</a>
      <a href="/services/tyre-change/" class="m-sub">Tyre Change</a>
      <a href="/services/breakdown-recovery/" class="m-sub">Breakdown Recovery</a>
      <a href="/#how">How it works</a>
      <a href="/#areas">Areas</a>
      <a href="/#reviews">Reviews</a>
      <a href="/#faq">FAQ</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href={phoneHref} class="m-call">Call {phoneLabel}</a>
    </nav>

    <main id="main">
      <slot />
    </main>

    <!-- ============ FOOTER ============ -->
    <footer>
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-brand">
            <a href="#top" class="wordmark" aria-label="Birmingham Jump Start home">
              <span class="bolt" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M13 2 4.5 13.5H11L9.5 22 19 10h-6.5L13 2z" /></svg>
              </span>
              <span>Birmingham Jump Start<small>24/7 Recovery</small></span>
            </a>
            <p>
              Birmingham's 24/7 jump start and recovery specialists. One call and
              you're moving again.
            </p>
          </div>
          <div class="foot-col">
            <h4>Services</h4>
            <ul>
              <li><a href="/services/jump-start/">Jump Start</a></li>
              <li><a href="/services/battery-replacement/">Battery Replacement</a></li>
              <li><a href="/services/towing-and-recovery/">Towing and Recovery</a></li>
              <li><a href="/services/emergency-fuel-delivery/">Emergency Fuel Delivery</a></li>
              <li><a href="/services/car-lockout/">Car Lockout</a></li>
              <li><a href="/services/tyre-change/">Tyre Change</a></li>
              <li><a href="/services/breakdown-recovery/">Breakdown Recovery</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h4>Explore</h4>
            <ul>
              <li><a href="/services/">All services</a></li>
              <li><a href="/about/">About us</a></li>
              <li><a href="/contact/">Contact us</a></li>
              <li><a href="/#how">How it works</a></li>
              <li><a href="/#areas">Areas we cover</a></li>
              <li><a href="/#reviews">Reviews</a></li>
              <li><a href="/#faq">FAQ</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h4>Contact (24/7)</h4>
            <ul>
              <li><a href={phoneHref}>{phoneLabel}</a></li>
              <li><a href={waHref} target="_blank" rel="noopener">WhatsApp us</a></li>
              <li><a href="/#areas">Birmingham, West Midlands</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-base">
          <span>© 2026 Birmingham Jump Start · Alliedzone Recovery Ltd. All rights reserved.</span>
          <span class="legal-links">
            <a href="/privacy-policy/">Privacy</a> ·
            <a href="/terms-and-conditions/">Terms</a> ·
            <a href="/disclaimer/">Disclaimer</a> ·
            <a href="/cookies/">Cookies</a>
          </span>
          <span class="credit">Designed by <a href="https://sitesbrand.com" target="_blank" rel="noopener">Sitesbrand</a></span>
        </div>
      </div>
    </footer>

    <!-- ============ STICKY MOBILE CALL BAR ============ -->
    <div class="callbar" role="navigation" aria-label="Quick contact">
      <a class="call" href={phoneHref}>
        <svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7a2 2 0 0 1 1.7 2.05z" /></svg>
        Call now: {phoneLabel}
      </a>
      <a class="wa" href={waHref} target="_blank" rel="noopener" aria-label="WhatsApp us">
        <svg viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.5L3 21l2-5.4A8.5 8.5 0 1 1 21 11.5z" /></svg>
      </a>
    </div>

    <script>
      // nav shadow on scroll
      const nav = document.getElementById("nav");
      const onScroll = () => nav && nav.classList.toggle("scrolled", window.scrollY > 24);
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // mobile menu
      const burger = document.getElementById("burger");
      const menu = document.getElementById("mobileMenu");
      burger?.addEventListener("click", () => {
        const open = menu?.classList.toggle("open") ?? false;
        burger.classList.toggle("open", open);
        burger.setAttribute("aria-expanded", String(open));
        burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      });
      menu?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          menu.classList.remove("open");
          burger?.classList.remove("open");
          burger?.setAttribute("aria-expanded", "false");
        })
      );

      // scroll reveal
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("rv-on");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -6% 0px" }
      );
      document.querySelectorAll(".rv").forEach((el) => io.observe(el));

      // faq accordion
      document.querySelectorAll(".faq").forEach((item) => {
        const btn = item.querySelector("button");
        btn?.addEventListener("click", () => {
          const wasOpen = item.classList.contains("open");
          document.querySelectorAll(".faq.open").forEach((o) => {
            o.classList.remove("open");
            o.querySelector("button")?.setAttribute("aria-expanded", "false");
          });
          if (!wasOpen) {
            item.classList.add("open");
            btn.setAttribute("aria-expanded", "true");
          }
        });
      });
    </script>
  </body>
</html>
